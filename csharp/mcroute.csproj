<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>mcroute</AssemblyName>
    <RootNamespace>Mcroute</RootNamespace>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.3.5</Version>
    <FileVersion>0.3.5.0</FileVersion>
    <AssemblyVersion>0.3.4.0</AssemblyVersion>
    <Product>mcroute — Minecraft Java 启动器</Product>
    <Company>Hourai-chiyo</Company>
    <Description>面向中国大陆网络环境的 Minecraft Java 启动器，重点是下载源路由与离线可自持。</Description>
    <Copyright>MIT License © 2026 Hourai-chiyo</Copyright>
    <AssemblyTitle>mcroute</AssemblyTitle>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
