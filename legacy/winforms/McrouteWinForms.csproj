<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>mcroute</AssemblyName>
    <RootNamespace>Mcroute</RootNamespace>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.6.2</Version>
    <FileVersion>0.6.2.0</FileVersion>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <Product>mcroute — Minecraft Java 启动器</Product>
    <Company>Hourai-chiyo</Company>
    <Description>面向中国大陆网络环境的 Minecraft Java 启动器，重点是下载源路由与离线可自持。</Description>
    <Copyright>MIT License © 2026 Hourai-chiyo</Copyright>
    <AssemblyTitle>mcroute (legacy WinForms/CLI)</AssemblyTitle>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Management" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\core\Commands.cs" Link="Core\Commands.cs" />
    <Compile Include="..\..\core\ExtraCommands.cs" Link="Core\ExtraCommands.cs" />
    <Compile Include="..\..\core\Http.cs" Link="Core\Http.cs" />
    <Compile Include="..\..\core\Java.cs" Link="Core\Java.cs" />
    <Compile Include="..\..\core\JavaSources.cs" Link="Core\JavaSources.cs" />
    <Compile Include="..\..\core\Json.cs" Link="Core\Json.cs" />
    <Compile Include="..\..\core\Loader.cs" Link="Core\Loader.cs" />
    <Compile Include="..\..\core\Meta.cs" Link="Core\Meta.cs" />
    <Compile Include="..\..\core\Mirrors.cs" Link="Core\Mirrors.cs" />
    <Compile Include="..\..\core\Mods.cs" Link="Core\Mods.cs" />
    <Compile Include="..\..\core\Modrinth.cs" Link="Core\Modrinth.cs" />
    <Compile Include="..\..\core\CurseForge.cs" Link="Core\CurseForge.cs" />
    <Compile Include="..\..\core\Packs.cs" Link="Core\Packs.cs" />
    <Compile Include="..\..\core\SafeZip.cs" Link="Core\SafeZip.cs" />
    <Compile Include="..\..\core\SafePath.cs" Link="Core\SafePath.cs" />
    <Compile Include="..\..\core\SelfTest.cs" Link="Core\SelfTest.cs" />
