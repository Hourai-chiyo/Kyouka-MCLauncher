<Window x:Class="Mcroute.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Kyouka MCLauncher"
        Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="15,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F5FB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryDim}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideNav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="7" Background="Transparent" Padding="10,0">
                            <Grid>
                                <Border x:Name="bar" Width="3" Height="14" CornerRadius="2"
                                        HorizontalAlignment="Left" Margin="-10,0,0,0"
                                        Background="Transparent"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryDim}"/>
                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource Primary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource Primary}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A63D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2559BE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B9C7E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F7F8FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Padding="12,7"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryDim}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryEdge}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource VersionItem}"/>
        </Style>

        <!-- ===== 细滚动条（跟随主题）===== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="b" CornerRadius="3" Margin="2,0"
                                Background="{DynamicResource TextFaint}" Opacity="0.55"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 扁平输入框（替换 WPF 默认的 3D 边框）===== -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C9D4E4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 扁平下拉框 ===== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" Margin="4,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F5FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryDim}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border x:Name="frame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="6" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <Path x:Name="arrow" Data="M0,0 L8,0 L4,5 Z" Fill="{DynamicResource TextMuted}"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   PopupAnimation="Fade" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource Surface}" Margin="0,4,0,0"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.14" Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Margin="0,4"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="#C9D4E4"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Primary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="frame" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 多行输出框：独立样式，避免被上面的全局 TextBox 样式（高度 32 / 垂直居中）污染 -->
        <Style x:Key="OutputBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D6E4F5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶部 ================= -->
        <Grid x:Name="TopBar" Grid.Row="0" Background="{DynamicResource Surface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="PageTitle" Grid.Column="1" Text="启动" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text}" Margin="22,0,0,0" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WinBtn}" Click="Min_Click" Content="—"/>
                <Button Style="{StaticResource WinBtn}" Click="Max_Click" Content="□"/>
                <Button Style="{StaticResource WinBtn}" Click="Close_Click" Content="✕" Foreground="#B42318"/>
            </StackPanel>

            <Border Grid.ColumnSpan="3" Height="1" Background="{DynamicResource Hairline}" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

                <!-- 启动页背景：默认是矢量山形；也可以在设置里换成自己的图片 -->
                <Grid x:Name="HeroLayer" Grid.ColumnSpan="2">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B2A4A" Offset="0"/>
                            <GradientStop Color="#2C4A78" Offset="0.55"/>
                            <GradientStop Color="#3F6B9E" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- 自定义背景图（默认隐藏） -->
                    <Border x:Name="HeroImageLayer" Visibility="Collapsed"/>

                    <!-- 默认矢量山形 -->
                    <Grid x:Name="HeroMountains">
                        <Path Data="M0,520 L200,360 L380,470 L560,300 L760,450 L1000,280 L1180,430 L1180,700 L0,700 Z"
                              Fill="#16304F" Opacity="0.55" Stretch="Fill"/>
                        <Path Data="M0,600 L180,470 L360,570 L540,430 L740,560 L940,420 L1180,520 L1180,700 L0,700 Z"
                              Fill="#0F2340" Opacity="0.8" Stretch="Fill"/>
                    </Grid>

                    <!-- 图片模式的暗色蒙版（保证白字可读） -->
                    <Border x:Name="HeroScrim" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#8C1B2A4A" Offset="0"/>
                                <GradientStop Color="#D90B1524" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

            <!-- 左侧栏 -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,1,0">
                <Grid Margin="16,14,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 品牌 -->
                        <RowDefinition Height="Auto"/>   <!-- 主按钮 -->
                        <RowDefinition Height="Auto"/>   <!-- 导航 -->
                        <RowDefinition Height="*"/>      <!-- 搜索 + 版本列表 -->
                        <RowDefinition Height="Auto"/>   <!-- 数据目录 -->
                        <RowDefinition Height="Auto"/>   <!-- 底部账号 -->
                    </Grid.RowDefinitions>

                    <!-- 品牌 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Primary}"/>
                        <TextBlock Text="Kyouka" Margin="9,0,0,0" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                        <TextBlock Text="MCLauncher" FontSize="10" Margin="3,2,0,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SideVersion" Text="" FontSize="9.5" Margin="6,3,0,0"
                                   Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 主按钮 -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}"
                                Content="开始游戏" Height="38" Click="Play_Click"/>
                        <Button x:Name="CloseGameButton" Style="{StaticResource GhostButton}" Content="关闭游戏"
                                Height="30" Margin="0,6,0,0" Visibility="Collapsed" Click="CloseGame_Click"/>
                    </StackPanel>

                    <!-- 导航 -->
                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <TextBlock Text="导航" FontSize="10" Foreground="{DynamicResource TextFaint}"
                                   Margin="10,0,0,4"/>
                        <RadioButton x:Name="NavLaunch" Style="{StaticResource SideNav}" Content="启动"
                                     GroupName="nav" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavDownload" Style="{StaticResource SideNav}" Content="下载"
                                     GroupName="nav" Margin="0,1,0,0" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavPacks" Style="{StaticResource SideNav}" Content="整合包"
                                     GroupName="nav" Margin="0,1,0,0" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavManage" Style="{StaticResource SideNav}" Content="管理"
                                     GroupName="nav" Margin="0,1,0,0" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource SideNav}" Content="设置"
                                     GroupName="nav" Margin="0,1,0,0" Checked="Nav_Checked"/>
                    </StackPanel>

                    <!-- 搜索 + 版本列表 -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="VersionSearch" Height="30" TextChanged="VersionSearch_TextChanged"/>
                                <TextBlock x:Name="SearchHint" Text="搜索版本…" FontSize="12"
                                           Foreground="{DynamicResource TextFaint}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="⟳" Width="34" Height="30"
                                    Margin="6,0,0,0" ToolTip="刷新版本列表" Click="Refresh_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,8">
                            <TextBlock Text="本地版本" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock x:Name="VersionCount" Text="" FontSize="11" Foreground="{DynamicResource TextFaint}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <ListBox x:Name="VersionList" Grid.Row="2" Style="{StaticResource PlainListBox}"
                                 SelectionChanged="VersionList_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <!-- 数据目录 -->
                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="28" CornerRadius="6" Background="{DynamicResource Bg}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="8,0"
                                ToolTip="{Binding ElementName=DataDirText, Path=Text}">
                            <TextBlock x:Name="DataDirText" Text="…" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="改" Width="40" Height="28"
                                Margin="6,0,0,0" Click="PickDataDir_Click"/>
                    </Grid>

                    <!-- 底部账号 -->
                    <Grid Grid.Row="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource PrimaryDim}">
                            <Grid>
                                <Ellipse Width="12" Height="12" Fill="{DynamicResource TextFaint}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                <Path Fill="{DynamicResource TextFaint}" Data="M0,10 C0,4 18,4 18,10 Z" Width="18" Height="10"
                                      Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                    MouseLeftButtonUp="Account_Click" ToolTip="点击登录（外置登录 / 皮肤站）">
                            <TextBlock x:Name="AccountName" Text="Steve" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}"/>
                            <TextBlock x:Name="AccountMode" Text="离线模式 · 点击登录" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开目录" Width="88" Height="28"
                                Click="OpenDir_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" ClipToBounds="True">

                <!-- 启动页 -->
                <Grid x:Name="PageLaunch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,24,0"
                            Width="420" CornerRadius="12" Background="{DynamicResource CardOverlay}" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="CardTitle" Text="准备就绪" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text}"/>
                            <TextBlock x:Name="CardDetail" Text="选择一个版本后点开始游戏" Margin="0,6,0,0"
                                       FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            <Grid Margin="0,14,0,0">
                                <Border Height="6" CornerRadius="3" Background="{DynamicResource Hairline}"/>
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Height="6"
                                        CornerRadius="3" Background="{DynamicResource Primary}"/>
                            </Grid>
                            <Button x:Name="CancelButton" Content="取消" Width="80" Height="28"
                                    HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed"
                                    Style="{StaticResource GhostButton}" Click="CancelButton_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="24,0,24,20" Height="190" CornerRadius="10" Background="#CC0B1524">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,0">
                                <TextBlock Text="日志" FontSize="11" Foreground="#8FA8C7" VerticalAlignment="Center"/>
                                <Button Content="清空" FontSize="10" Foreground="#8FA8C7" Background="Transparent"
                                        BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"
                                        Click="ClearLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogBox" Grid.Row="1" Margin="12,2,12,8" Style="{StaticResource OutputBox}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 下载页 -->
                <Grid x:Name="PageDownload" Background="{DynamicResource PageBg}" Visibility="Collapsed">
                    <Border Margin="24" Background="{DynamicResource Surface}" CornerRadius="12"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="24">
                        <StackPanel>
                            <TextBlock Text="下载 / 安装" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="下载原版版本，或给某个版本装加载器（自动下载原版 + 安装 + 补库）"
                                       Margin="0,6,0,18" FontSize="12" Foreground="{DynamicResource TextMuted}"/>

                            <TextBlock Text="MC 版本（例如 1.20.1）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DownloadVersion" Text="1.21.1" Width="220" HorizontalAlignment="Left"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="下载原版" Width="110"
                                        Click="Fetch_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="跳过资源下载" Width="120" Margin="8,0,0,0"
                                        Click="FetchNoAssets_Click"/>
                            </WrapPanel>

                            <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,20,0,18"/>

                            <TextBlock Text="加载器" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel>
                                <ComboBox x:Name="LoaderKind" Width="140">
                                    <ComboBoxItem Content="fabric" IsSelected="True"/>
                                    <ComboBoxItem Content="quilt"/>
                                    <ComboBoxItem Content="legacyfabric"/>
                                    <ComboBoxItem Content="forge"/>
                                    <ComboBoxItem Content="neoforge"/>
                                </ComboBox>
                                <TextBox x:Name="LoaderVersion" Text="1.20.1" Width="140" Margin="8,0,0,0"/>
                                <Button Style="{StaticResource GhostButton}" Content="安装加载器" Width="110"
                                        Margin="8,0,0,0" Click="Loader_Click"/>
                            </WrapPanel>
                            <TextBlock Text="forge 写 1.7.10 或 1.20.1-47.2.0 都行（自动补全）；neoforge 写 21.1.264 / 47.1.106"
                                       Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextFaint}"/>

                            <Border Height="1" Background="{DynamicResource Hairline}" Margin="0,20,0,18"/>

                            <TextBlock Text="Java" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel>
                                <ComboBox x:Name="JavaMajor" Width="80">
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="11"/>
                                    <ComboBoxItem Content="17" IsSelected="True"/>
                                    <ComboBoxItem Content="21"/>
                                </ComboBox>
                                <Button Style="{StaticResource GhostButton}" Content="下载并安装 Java" Width="150"
                                        Margin="8,0,0,0" Click="InstallJava_Click"/>
                            </WrapPanel>
                            <TextBlock Text="源：Adoptium（清华镜像）→ Azul Zulu → AWS Corretto"
                                       Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 整合包页 -->
                <Grid x:Name="PagePacks" Background="{DynamicResource PageBg}" Visibility="Collapsed">
                    <Border Margin="24" Background="{DynamicResource Surface}" CornerRadius="12"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="24">
                        <StackPanel>
                            <TextBlock Text="整合包" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="支持 Modrinth .mrpack / MultiMC·Prism 实例包 / CurseForge zip（自动识别）"
                                       Margin="0,6,0,18" FontSize="12" Foreground="{DynamicResource TextMuted}"/>

                            <TextBlock Text="包文件" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PackPath" Width="520" IsReadOnly="True"/>
                                <Button Style="{StaticResource GhostButton}" Content="浏览..." Width="90"
                                        Margin="8,0,0,0" Click="BrowsePack_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="安装" Width="80"
                                        Margin="8,0,0,0" Click="InstallPack_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="浏览 Modrinth 整合包" Width="160"
                                        Margin="8,0,0,0" Click="BrowseModpackOnline_Click"/>
                            </StackPanel>

                            <TextBlock Text="装完会自动补全依赖，可以直接到「启动」页启动。也可以点「浏览 Modrinth 整合包」在线下载。CurseForge 包需要 API key。"
                                       Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource TextFaint}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 管理页 -->
                <Grid x:Name="PageManage" Background="{DynamicResource PageBg}" Visibility="Collapsed">
                    <Border Margin="24" Background="{DynamicResource Surface}" CornerRadius="12"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="管理" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="所有本地版本：体检 / 测试启动 / 生成双击启动器"
                                           Margin="0,6,0,16" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Text="版本列表" Style="{StaticResource FieldLabel}" Margin="0"/>
                                <TextBlock x:Name="ManageCount" Text="" FontSize="11"
                                           Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="ManageList" Grid.Column="0" Style="{StaticResource PlainListBox}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                                <Border Grid.Column="2" Background="#0B1524" CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="输出" FontSize="11" Foreground="#8FA8C7"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ManageOutput" Grid.Row="1" Margin="12,2,12,10" Style="{StaticResource OutputBox}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="刷新" Width="80"
                                        Click="RefreshManage_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="体检" Width="80" Margin="8,0,0,0"
                                        Click="Verify_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="测试启动" Width="100" Margin="8,0,0,0"
                                        Click="Test_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="生成启动器" Width="110" Margin="8,0,0,0"
                                        Click="Mkbat_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="打开目录" Width="90" Margin="8,0,0,0"
                                        Click="OpenManageDir_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="复制路径" Width="90" Margin="8,0,0,0"
                                        Click="CopyManagePath_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="Mods" Width="80" Margin="8,0,0,0"
                                        Click="OpenMods_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="Mods 下载" Width="100" Margin="8,0,0,0"
                                        Click="OpenModsBrowser_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="资源包 · 光影" Width="110" Margin="8,0,0,0"
                                Click="OpenPacks_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="实例" Width="80" Margin="8,0,0,0"
                                Click="OpenInstances_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="Cleanroom 修复" Width="130" Margin="8,0,0,0"
                                Click="FixCleanroom_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 设置页 -->
                <Grid x:Name="PageSettings" Background="{DynamicResource PageBg}" Visibility="Collapsed">
                    <Border Margin="24" Background="{DynamicResource Surface}" CornerRadius="12"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>

                            <TextBlock Text="数据目录" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="SettingsDataDir" Width="520" IsReadOnly="True"/>
                                <Button Style="{StaticResource GhostButton}" Content="选择..." Width="90"
                                        Margin="8,0,0,0" Click="PickDataDir_Click"/>
                            </StackPanel>

                            <TextBlock Text="主题" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                            <ComboBox x:Name="ThemeBox" Width="180" HorizontalAlignment="Left"
                                      SelectionChanged="ThemeBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" Tag="auto" IsSelected="True"/>
                                <ComboBoxItem Content="浅色" Tag="light"/>
                                <ComboBoxItem Content="深色" Tag="dark"/>
                            </ComboBox>

                            <CheckBox x:Name="GlassBox" Margin="0,12,0,0"
                                      Content="玻璃面板（卡片半透明，透出背景图）"
                                      Foreground="{DynamicResource TextSub}"
                                      Checked="GlassBox_Changed" Unchecked="GlassBox_Changed"/>

                            <TextBlock Text="启动页背景" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="BgPathText" Width="400" IsReadOnly="True"/>
                                <Button Style="{StaticResource GhostButton}" Content="选择图片..." Width="100"
                                        Margin="8,0,0,0" Click="PickBackground_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="恢复默认" Width="90"
                                        Margin="8,0,0,0" Click="ResetBackground_Click"/>
                            </StackPanel>
                            <TextBlock Text="支持 jpg / png / bmp；图片只保存在本地数据目录，不会打包进程序"
                                       Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextFaint}"/>

                            <CheckBox x:Name="BgAllPagesBox" Margin="0,10,0,0"
                                      Content="背景图在所有页面显示（不只启动页）"
                                      Foreground="{DynamicResource TextSub}"
                                      Checked="BgAllPages_Changed" Unchecked="BgAllPages_Changed"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="暗度" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextSub}"/>
                                <Slider x:Name="BgDimSlider" Grid.Column="1" Width="240" Height="24"
                                        HorizontalAlignment="Left" Margin="10,0,0,0"
                                        Minimum="0" Maximum="100" Value="35"
                                        ValueChanged="BgDimSlider_ValueChanged"/>
                                <TextBlock x:Name="BgDimText" Grid.Column="2" FontSize="11" Width="40"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模糊" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextSub}"/>
                                <Slider x:Name="BgBlurSlider" Grid.Column="1" Width="240" Height="24"
                                        HorizontalAlignment="Left" Margin="10,0,0,0"
                                        Minimum="0" Maximum="24" Value="0"
                                        ValueChanged="BgBlurSlider_ValueChanged"/>
                                <TextBlock x:Name="BgBlurText" Grid.Column="2" FontSize="11" Width="40"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                            </Grid>

                            <TextBlock Text="最大内存（例如 2G / 4G / 8192M）" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                            <TextBox x:Name="MemoryBox" Text="2G" Width="140" HorizontalAlignment="Left"/>

                            <TextBlock Text="本机 Java" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                            <ListBox x:Name="JavaList" Height="150" FontFamily="Consolas" FontSize="11"
                                     Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}"/>
                            <Button Style="{StaticResource GhostButton}" Content="重新检测 Java" Width="120"
                                    Margin="0,8,0,0" HorizontalAlignment="Left" Click="RefreshJava_Click"/>

                            <CheckBox x:Name="ParallelBox" Margin="0,14,0,0"
                                      Content="分段下载（实验性：单连接被限速时可能有帮助，否则会更慢）"
                                      Foreground="{DynamicResource TextSub}"
                                      Checked="ParallelBox_Changed" Unchecked="ParallelBox_Changed"/>

                            <TextBlock Text="下载源（镜像）" Style="{StaticResource FieldLabel}" Margin="0,22,0,6"/>
                            <WrapPanel>
                                <Button Style="{StaticResource GhostButton}" Content="测速" Width="90"
                                        Click="MirrorSpeedTest_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="打开配置" Width="110"
                                        Margin="8,0,0,0" Click="OpenMirrorsCfg_Click"/>
                                <TextBlock x:Name="MirrorHint" VerticalAlignment="Center" Margin="12,0,0,0"
                                           FontSize="11" Foreground="{DynamicResource TextFaint}"
                                           Text="镜像只作优先尝试，失败自动回落官方源"/>
                            </WrapPanel>
                            <ListBox x:Name="MirrorList" Height="92" Margin="0,8,0,0"
                                     Background="{DynamicResource InputBg}"
                                     BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                     FontFamily="Consolas" FontSize="11"/>
                        
            <TextBlock Text="关于与更新" Style="{StaticResource FieldLabel}" Margin="0,22,0,6"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AboutVersion" Text="Kyouka MCLauncher" FontSize="12"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSub}"/>
                <Button Style="{StaticResource GhostButton}" Content="检查更新" Width="100"
                        Margin="12,0,0,0" Click="CheckUpdate_Click"/>
                <TextBlock x:Name="UpdateStatus" Margin="12,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{DynamicResource TextFaint}"/>
            </StackPanel>
            <TextBlock Text="自动更新：发现新版本会下载并在重启后替换；失败会保留原程序。"
                       FontSize="10.5" Margin="0,6,0,0" Foreground="{DynamicResource TextFaint}"/>
            <TextBlock Text="图标使用 EmoteLab 及其内置资源制作；角色「镜花」为作者自设。"
                       FontSize="10.5" Margin="0,2,0,0" Foreground="{DynamicResource TextFaint}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="NOT AN OFFICIAL MINECRAFT PRODUCT. 与 Mojang / Microsoft 无任何隶属关系。"
                       FontSize="10.5" Margin="0,2,0,0" Foreground="{DynamicResource TextFaint}"
                       TextWrapping="Wrap"/>
        </StackPanel>
                    </ScrollViewer>
                        </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="11"
                           Foreground="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionText" Text="WPF" FontSize="11" Foreground="{DynamicResource TextFaint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
