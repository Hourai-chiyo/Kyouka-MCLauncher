<Application x:Class="Mcroute.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Application.Resources>
        <!-- 全局配色（与 docs/ui-mockup-v1.svg 同一套参数） -->
        <SolidColorBrush x:Key="Bg"          Color="#F7F8FA"/>
        <SolidColorBrush x:Key="Surface"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border"      Color="#E4E7EC"/>
        <SolidColorBrush x:Key="Hairline"    Color="#EDEFF2"/>
        <SolidColorBrush x:Key="Primary"     Color="#2F6FEB"/>
        <SolidColorBrush x:Key="PrimaryDim"  Color="#EEF4FF"/>
        <SolidColorBrush x:Key="PrimaryEdge" Color="#CFE0FF"/>
        <SolidColorBrush x:Key="Text"        Color="#101828"/>
        <SolidColorBrush x:Key="TextSub"     Color="#344054"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#667085"/>
        <SolidColorBrush x:Key="TextFaint"   Color="#98A2B3"/>

        <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>
    </Application.Resources>
</Application>
