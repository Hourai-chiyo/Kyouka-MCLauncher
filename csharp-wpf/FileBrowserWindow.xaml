<Window x:Class="Mcroute.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="浏览文件" Width="820" Height="580" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI" SnapsToDevicePixels="True" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FileItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,6"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryDim}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryEdge}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" CornerRadius="12" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="44" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="浏览文件（应用内，不需要资源管理器）" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource WinBtn}" Content="✕" HorizontalAlignment="Right"
                        Margin="0,0,8,0" Click="Close_Click" Foreground="#B42318"/>
            </Grid>

            <!-- 路径 + 操作 -->
            <Grid Grid.Row="1" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="↑ 上级" Width="76"
                        Click="Up_Click"/>
                <Border Grid.Column="1" Margin="8,0" Height="30" CornerRadius="6"
                        Background="{DynamicResource FieldBg}"
                        BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" Padding="8,0">
                    <TextBlock x:Name="PathText" Text="…" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSub}" TextTrimming="CharacterEllipsis"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Content="复制路径" Width="86" Click="CopyPath_Click"/>
                    <Button Style="{StaticResource GhostButton}" Content="刷新" Width="64" Margin="6,0,0,0"
                            Click="Refresh_Click"/>
                </StackPanel>
            </Grid>

            <!-- 列表 -->
            <ListBox x:Name="FileList" Grid.Row="2" Margin="16,0,16,0"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource FileItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="FileList_MouseDoubleClick"/>

            <!-- 底部 -->
            <Grid Grid.Row="3" Margin="16,10,16,14">
                <TextBlock x:Name="HintText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextFaint}"
                           Text="双击进入文件夹 / 双击文件用默认程序打开；上方可复制路径"/>
                <Button Style="{StaticResource GhostButton}" Content="关闭" Width="76"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
