<Window x:Class="Mcroute.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="mcroute — Minecraft 启动器（WPF 原型）"
        Width="1180" Height="760" MinWidth="940" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 窗口按钮 -->
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部导航项 -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="15,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F5FB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Primary}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A63D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2559BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮 -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F7F8FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 版本列表项 -->
        <Style x:Key="VersionItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Padding="14,10"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FAFBFE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDim}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryEdge}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource VersionItem}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶部导航 ================= -->
        <Grid Grid.Row="0" Background="{StaticResource Surface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource Primary}"/>
                <TextBlock Text="mcroute" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="34,0,0,0" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <RadioButton x:Name="NavLaunch" Style="{StaticResource NavItem}" Content="启动" IsChecked="True"
                             GroupName="nav" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavDownload" Style="{StaticResource NavItem}" Content="下载"
                             GroupName="nav" Margin="6,0,0,0" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPacks" Style="{StaticResource NavItem}" Content="整合包"
                             GroupName="nav" Margin="6,0,0,0" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="设置"
                             GroupName="nav" Margin="6,0,0,0" Checked="Nav_Checked"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WinBtn}" Click="Min_Click" Content="—"/>
                <Button Style="{StaticResource WinBtn}" Click="Max_Click" Content="□"/>
                <Button Style="{StaticResource WinBtn}" Click="Close_Click" Content="✕" Foreground="#B42318"/>
            </StackPanel>

            <Border Grid.ColumnSpan="3" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧栏 -->
            <Border Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
                <Grid Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 账号 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="60" Height="60" CornerRadius="15" Background="#E8EEF9">
                            <Grid>
                                <Ellipse Width="24" Height="24" Fill="#B9C7E0" VerticalAlignment="Top" Margin="0,11,0,0"/>
                                <Path Fill="#B9C7E0" Data="M0,20 C0,7 34,7 34,20 Z" Width="34" Height="20"
                                      Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,9"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="14,6,0,0">
                            <TextBlock Text="Steve" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            <Border Background="#F2F4F7" CornerRadius="9" Padding="9,2" Margin="0,6,0,0"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="离线模式" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 选择版本 -->
                    <TextBlock Grid.Row="1" Text="选择版本" Margin="0,26,0,10" FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"/>

                    <ListBox Grid.Row="2" x:Name="VersionList" Style="{StaticResource PlainListBox}"
                             SelectionChanged="VersionList_SelectionChanged">
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="1.20.1 — Fabric 0.19.5" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}"/>
                                <TextBlock Text="已装 47 个 mod" Margin="0,3,0,0" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="1.20.1 — NeoForge 47.1.106" FontSize="13"
                                           Foreground="{StaticResource TextSub}"/>
                                <TextBlock Text="纯 Forge 系，无 mod" Margin="0,3,0,0" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="1.12.2 — Forge 14.23.5" FontSize="13"
                                           Foreground="{StaticResource TextSub}"/>
                                <TextBlock Text="老版本 · Java 8" Margin="0,3,0,0" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel>
                                <TextBlock Text="1.7.10 — Forge 10.13.4" FontSize="13"
                                           Foreground="{StaticResource TextSub}"/>
                                <TextBlock Text="legacy · Java 8" Margin="0,3,0,0" FontSize="11"
                                           Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <!-- 底部按钮 -->
                    <StackPanel Grid.Row="3">
                        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}"
                                Content="开始游戏" Click="Play_Click"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="选择版本"/>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="实例设置"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主区域 -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B2A4A" Offset="0"/>
                        <GradientStop Color="#2C4A78" Offset="0.55"/>
                        <GradientStop Color="#3F6B9E" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Path Data="M0,520 L200,360 L380,470 L560,300 L760,450 L1000,280 L1180,430 L1180,700 L0,700 Z"
                      Fill="#16304F" Opacity="0.55" Stretch="Fill"/>
                <Path Data="M0,600 L180,470 L360,570 L540,430 L740,560 L940,420 L1180,520 L1180,700 L0,700 Z"
                      Fill="#0F2340" Opacity="0.8" Stretch="Fill"/>

                <Border VerticalAlignment="Bottom" Height="200">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00131F2E" Offset="0"/>
                            <GradientStop Color="#C0131F2E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 信息卡 -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,26,28,0"
                        Width="400" CornerRadius="12" Background="#F2FFFFFF" Padding="20">
                    <StackPanel>
                        <TextBlock x:Name="CardTitle" Text="正在准备启动" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}"/>
                        <TextBlock x:Name="CardDetail" Text="1.20.1 · Fabric 0.19.5 · Java 21 · 4 GB"
                                   Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <Border Height="6" CornerRadius="3" Background="#EDEFF2" Margin="0,14,0,0">
                            <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="120"
                                    CornerRadius="3" Background="{StaticResource Primary}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 左下角：页面提示 -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="32,0,0,26">
                    <TextBlock x:Name="PageHint" Text="启动页 · 选版本然后点开始游戏"
                               FontSize="13" Foreground="#D6E4F5"/>
                    <TextBlock Text="WPF 视觉原型：界面是壳，功能逻辑复用 C# Core"
                               FontSize="11" Foreground="#8FA8C7" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock x:Name="StatusText" Text="就绪 · 镜像 mirrors.hit.edu.cn · 7.8 MB/s"
                           FontSize="11" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                <TextBlock Text="v0.2.0 原型 · 界面壳" FontSize="11" Foreground="{StaticResource TextFaint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
