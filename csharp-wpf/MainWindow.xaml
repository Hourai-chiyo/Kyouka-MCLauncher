<Window x:Class="Mcroute.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="mcroute — Minecraft 启动器"
        Width="1180" Height="760" MinWidth="940" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8" Background="Transparent" Padding="15,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2F5FB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Primary}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A63D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2559BE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B9C7E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F7F8FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Padding="13,9"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FAFBFE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDim}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryEdge}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource VersionItem}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶部 ================= -->
        <Grid Grid.Row="0" Background="{StaticResource Surface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource Primary}"/>
                <TextBlock Text="mcroute" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="34,0,0,0" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <RadioButton x:Name="NavLaunch" Style="{StaticResource NavItem}" Content="启动" IsChecked="True"
                             GroupName="nav" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavDownload" Style="{StaticResource NavItem}" Content="下载"
                             GroupName="nav" Margin="6,0,0,0" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavPacks" Style="{StaticResource NavItem}" Content="整合包"
                             GroupName="nav" Margin="6,0,0,0" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavManage" Style="{StaticResource NavItem}" Content="管理"
                             GroupName="nav" Margin="6,0,0,0" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="设置"
                             GroupName="nav" Margin="6,0,0,0" Checked="Nav_Checked"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WinBtn}" Click="Min_Click" Content="—"/>
                <Button Style="{StaticResource WinBtn}" Click="Max_Click" Content="□"/>
                <Button Style="{StaticResource WinBtn}" Click="Close_Click" Content="✕" Foreground="#B42318"/>
            </StackPanel>

            <Border Grid.ColumnSpan="3" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- ================= 主体 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧栏 -->
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
                <Grid Margin="20,18,20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="14" Background="#E8EEF9">
                            <Grid>
                                <Ellipse Width="22" Height="22" Fill="#B9C7E0" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                <Path Fill="#B9C7E0" Data="M0,19 C0,7 32,7 32,19 Z" Width="32" Height="19"
                                      Stretch="Fill" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="12,4,0,0">
                            <TextBlock Text="Steve" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            <Border Background="#F2F4F7" CornerRadius="9" Padding="8,2" Margin="0,5,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="离线模式" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                        <TextBlock Text="数据目录" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="30" CornerRadius="6" Background="#F7F8FA"
                                    BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8,0">
                                <TextBlock x:Name="DataDirText" Text="…" FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="改"
                                    Width="44" Height="30" Margin="6,0,0,0" Click="PickDataDir_Click"/>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="本地版本" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock x:Name="VersionCount" Text="" FontSize="11" Foreground="{StaticResource TextFaint}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <ListBox x:Name="VersionList" Grid.Row="1" Style="{StaticResource PlainListBox}"
                                 SelectionChanged="VersionList_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <StackPanel Grid.Row="3">
                        <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Content="开始游戏"
                                Click="Play_Click"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="刷新"
                                    Click="Refresh_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开目录"
                                    Click="OpenDir_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" ClipToBounds="True">

                <!-- 启动页背景：默认是矢量山形；也可以在设置里换成自己的图片 -->
                <Grid x:Name="HeroLayer">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B2A4A" Offset="0"/>
                            <GradientStop Color="#2C4A78" Offset="0.55"/>
                            <GradientStop Color="#3F6B9E" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <!-- 自定义背景图（默认隐藏） -->
                    <Border x:Name="HeroImageLayer" Visibility="Collapsed"/>

                    <!-- 默认矢量山形 -->
                    <Grid x:Name="HeroMountains">
                        <Path Data="M0,520 L200,360 L380,470 L560,300 L760,450 L1000,280 L1180,430 L1180,700 L0,700 Z"
                              Fill="#16304F" Opacity="0.55" Stretch="Fill"/>
                        <Path Data="M0,600 L180,470 L360,570 L540,430 L740,560 L940,420 L1180,520 L1180,700 L0,700 Z"
                              Fill="#0F2340" Opacity="0.8" Stretch="Fill"/>
                    </Grid>

                    <!-- 图片模式的暗色蒙版（保证白字可读） -->
                    <Border x:Name="HeroScrim" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#8C1B2A4A" Offset="0"/>
                                <GradientStop Color="#D90B1524" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- 启动页 -->
                <Grid x:Name="PageLaunch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,24,0"
                            Width="420" CornerRadius="12" Background="#F2FFFFFF" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="CardTitle" Text="准备就绪" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}"/>
                            <TextBlock x:Name="CardDetail" Text="选择一个版本后点开始游戏" Margin="0,6,0,0"
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            <Grid Margin="0,14,0,0">
                                <Border Height="6" CornerRadius="3" Background="#EDEFF2"/>
                                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" Height="6"
                                        CornerRadius="3" Background="{StaticResource Primary}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Margin="24,0,24,20" Height="190" CornerRadius="10" Background="#CC0B1524">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="12,0">
                                <TextBlock Text="日志" FontSize="11" Foreground="#8FA8C7" VerticalAlignment="Center"/>
                                <Button Content="清空" FontSize="10" Foreground="#8FA8C7" Background="Transparent"
                                        BorderThickness="0" HorizontalAlignment="Right" Cursor="Hand"
                                        Click="ClearLog_Click"/>
                            </Grid>
                            <TextBox x:Name="LogBox" Grid.Row="1" Margin="12,2,12,8" Padding="0" Background="Transparent"
                                     BorderThickness="0" Foreground="#D6E4F5" FontFamily="Consolas"
                                     FontSize="11" IsReadOnly="True" TextWrapping="NoWrap"
                                     AcceptsReturn="True" VerticalContentAlignment="Top" MinLines="6"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 下载页 -->
                <Grid x:Name="PageDownload" Background="{StaticResource Bg}" Visibility="Collapsed">
                    <Border Margin="24" Background="{StaticResource Surface}" CornerRadius="12"
                            BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="24">
                        <StackPanel>
                            <TextBlock Text="下载 / 安装" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="下载原版版本，或给某个版本装加载器（自动下载原版 + 安装 + 补库）"
                                       Margin="0,6,0,18" FontSize="12" Foreground="{StaticResource TextMuted}"/>

                            <TextBlock Text="MC 版本（例如 1.20.1）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DownloadVersion" Text="1.21.1" Width="220" HorizontalAlignment="Left"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="下载原版" Width="110"
                                        Click="Fetch_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="跳过资源下载" Width="120" Margin="8,0,0,0"
                                        Click="FetchNoAssets_Click"/>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Hairline}" Margin="0,20,0,18"/>

                            <TextBlock Text="加载器" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="LoaderKind" Width="150">
                                    <ComboBoxItem Content="fabric" IsSelected="True"/>
                                    <ComboBoxItem Content="quilt"/>
                                    <ComboBoxItem Content="legacyfabric"/>
                                    <ComboBoxItem Content="forge"/>
                                    <ComboBoxItem Content="neoforge"/>
                                </ComboBox>
                                <TextBox x:Name="LoaderVersion" Text="1.20.1" Width="180" Margin="8,0,0,0"/>
                                <Button Style="{StaticResource GhostButton}" Content="安装加载器" Width="120"
                                        Margin="8,0,0,0" Click="Loader_Click"/>
                            </StackPanel>
                            <TextBlock Text="forge 写 1.7.10 或 1.20.1-47.2.0 都行（自动补全）；neoforge 写 21.1.264 / 47.1.106"
                                       Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextFaint}"/>

                            <Border Height="1" Background="{StaticResource Hairline}" Margin="0,20,0,18"/>

                            <TextBlock Text="Java" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="JavaMajor" Width="90">
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="11"/>
                                    <ComboBoxItem Content="17" IsSelected="True"/>
                                    <ComboBoxItem Content="21"/>
                                </ComboBox>
                                <Button Style="{StaticResource GhostButton}" Content="下载并安装 Java" Width="150"
                                        Margin="8,0,0,0" Click="InstallJava_Click"/>
                            </StackPanel>
                            <TextBlock Text="源：Adoptium（清华镜像）→ Azul Zulu → AWS Corretto"
                                       Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 整合包页 -->
                <Grid x:Name="PagePacks" Background="{StaticResource Bg}" Visibility="Collapsed">
                    <Border Margin="24" Background="{StaticResource Surface}" CornerRadius="12"
                            BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="24">
                        <StackPanel>
                            <TextBlock Text="整合包" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="支持 Modrinth .mrpack / MultiMC·Prism 实例包 / CurseForge zip（自动识别）"
                                       Margin="0,6,0,18" FontSize="12" Foreground="{StaticResource TextMuted}"/>

                            <TextBlock Text="包文件" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PackPath" Width="520" IsReadOnly="True"/>
                                <Button Style="{StaticResource GhostButton}" Content="浏览..." Width="90"
                                        Margin="8,0,0,0" Click="BrowsePack_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="安装" Width="80"
                                        Margin="8,0,0,0" Click="InstallPack_Click"/>
                            </StackPanel>

                            <TextBlock Text="装完会自动补全依赖，可以直接到「启动」页启动。CurseForge 包需要 API key（写 mcdata\cf_api_key.txt）。"
                                       Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource TextFaint}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 管理页 -->
                <Grid x:Name="PageManage" Background="{StaticResource Bg}" Visibility="Collapsed">
                    <Border Margin="24" Background="{StaticResource Surface}" CornerRadius="12"
                            BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="管理" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="所有本地版本：体检 / 测试启动 / 生成双击启动器"
                                           Margin="0,6,0,16" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Text="版本列表" Style="{StaticResource FieldLabel}" Margin="0"/>
                                <TextBlock x:Name="ManageCount" Text="" FontSize="11"
                                           Foreground="{StaticResource TextFaint}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="ManageList" Grid.Column="0" Style="{StaticResource PlainListBox}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                                <Border Grid.Column="2" Background="#0B1524" CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="输出" FontSize="11" Foreground="#8FA8C7"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="ManageOutput" Grid.Row="1" Margin="12,2,12,10" Padding="0"
                                                 Background="Transparent" BorderThickness="0" Foreground="#D6E4F5"
                                                 FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                                 VerticalContentAlignment="Top"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="刷新" Width="80"
                                        Click="RefreshManage_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="体检" Width="80" Margin="8,0,0,0"
                                        Click="Verify_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="测试启动" Width="100" Margin="8,0,0,0"
                                        Click="Test_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="生成启动器" Width="110" Margin="8,0,0,0"
                                        Click="Mkbat_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="打开目录" Width="90" Margin="8,0,0,0"
                                        Click="OpenManageDir_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 设置页 -->
                <Grid x:Name="PageSettings" Background="{StaticResource Bg}" Visibility="Collapsed">
                    <Border Margin="24" Background="{StaticResource Surface}" CornerRadius="12"
                            BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="24">
                        <StackPanel>
                            <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>

                            <TextBlock Text="数据目录" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="SettingsDataDir" Width="520" IsReadOnly="True"/>
                                <Button Style="{StaticResource GhostButton}" Content="选择..." Width="90"
                                        Margin="8,0,0,0" Click="PickDataDir_Click"/>
                            </StackPanel>

                            <TextBlock Text="启动页背景" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="BgPathText" Width="400" IsReadOnly="True"/>
                                <Button Style="{StaticResource GhostButton}" Content="选择图片..." Width="100"
                                        Margin="8,0,0,0" Click="PickBackground_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="恢复默认" Width="90"
                                        Margin="8,0,0,0" Click="ResetBackground_Click"/>
                            </StackPanel>
                            <TextBlock Text="支持 jpg / png / bmp；图片只保存在本地数据目录，不会打包进程序"
                                       Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextFaint}"/>

                            <TextBlock Text="最大内存（例如 2G / 4G / 8192M）" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                            <TextBox x:Name="MemoryBox" Text="2G" Width="140" HorizontalAlignment="Left"/>

                            <TextBlock Text="本机 Java" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                            <ListBox x:Name="JavaList" Height="150" FontFamily="Consolas" FontSize="11"
                                     Background="#FAFBFC" BorderBrush="{StaticResource Border}"/>
                            <Button Style="{StaticResource GhostButton}" Content="重新检测 Java" Width="120"
                                    Margin="0,8,0,0" HorizontalAlignment="Left" Click="RefreshJava_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ================= 状态栏 ================= -->
        <Border Grid.Row="2" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="11"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>
                <TextBlock Text="v0.2.0 · WPF" FontSize="11" Foreground="{StaticResource TextFaint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
