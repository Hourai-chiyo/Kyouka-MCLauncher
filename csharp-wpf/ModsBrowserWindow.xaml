<Window x:Class="Mcroute.ModsBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下载 Mod" Width="900" Height="640" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Microsoft YaHei UI" SnapsToDevicePixels="True" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSub}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HitItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="8" Padding="10,8"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryDim}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryEdge}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Bg}" CornerRadius="12" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Direction="270"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Height="44" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="下载 Mod" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource WinBtn}" Content="✕" HorizontalAlignment="Right"
                        Margin="0,0,8,0" Click="Close_Click" Foreground="#B42318"/>
            </Grid>

            <!-- 来源 + 筛选 -->
            <Grid Grid.Row="1" Margin="16,0,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="来源" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}"/>
                    <ComboBox x:Name="SourceBox" Width="120" Height="28" Margin="6,0,0,0"
                              SelectionChanged="SourceBox_Changed">
                        <ComboBoxItem Content="Modrinth" IsSelected="True"/>
                        <ComboBoxItem Content="CurseForge" ToolTip="需要 API Key；官方控制台只能 Google 登录"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="MC" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBox x:Name="McBox" Width="90" Height="28" Margin="6,0,0,0"/>
                    <TextBlock Text="加载器" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource TextMuted}"/>
                    <ComboBox x:Name="LoaderBox" Width="110" Height="28" Margin="6,0,0,0">
                        <ComboBoxItem Content="fabric"/>
                        <ComboBoxItem Content="forge"/>
                        <ComboBoxItem Content="neoforge"/>
                        <ComboBoxItem Content="quilt"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- 搜索栏 -->
            <Grid Grid.Row="2" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Height="32" KeyDown="SearchBox_KeyDown"/>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="搜索" Width="76"
                        Margin="8,0,0,0" Click="Search_Click"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开 mods 目录" Width="120"
                        Margin="8,0,0,0" Click="OpenModsDir_Click"/>
            </Grid>

            <!-- CurseForge Key 输入（仅在没配置时出现） -->
            <Border x:Name="KeyPanel" Grid.Row="3" Margin="16,0,16,10" Padding="10,8"
                    CornerRadius="8" Background="{DynamicResource PrimaryDim}"
                    BorderBrush="{DynamicResource PrimaryEdge}" BorderThickness="1" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CurseForge 需要 API Key" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}"/>
                        <TextBox x:Name="KeyBox" Height="28" Margin="0,6,0,0"
                                 ToolTip="从 console.curseforge.com 复制的 API Key（60 位，通常以 $2a$10$ 开头）"/>

                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="这是什么" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSub}"/>
                            <TextBlock FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="· CurseForge 的开发者 API Key：用它的官方接口搜 mod、取下载地址；官方按 Key 限流。"/>

                            <TextBlock Text="怎么拿到" FontSize="10.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSub}"/>
                            <TextBlock FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="· console.curseforge.com → API Keys → 复制一串 60 位字符。&#10;· ⚠ 这个控制台目前只支持 Google 登录，国内网络通常打不开——申请不到很正常。"/>

                            <TextBlock Text="填进来之后" FontSize="10.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSub}"/>
                            <TextBlock FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="· 只保存在本机 &lt;数据目录&gt;/cf_api_key.txt，不会上传到任何服务器。&#10;· 想换机器/分享给别人时，把文件拷过去即可（不建议公开分享，会被滥用）。"/>

                            <TextBlock Text="为什么启动器不帮你内置" FontSize="10.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSub}"/>
                            <TextBlock FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="· Key 与申请人绑定，公开分发违反条款；exe 里一行 strings 就能提取；配额被所有人共用会很快 429；被滥用封的是申请人的号。"/>

                            <TextBlock Text="没有 Key 也能用" FontSize="10.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSub}"/>
                            <TextBlock FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="· 来源切回 Modrinth（免 Key，直接搜）；或用底部「从链接安装」（mcmod 过验证码拿到链接、网盘直链都行）。"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,2,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="获取 Key" Width="90" Height="28"
                                Click="OpenCfConsole_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="保存" Width="90" Height="28"
                                Margin="0,8,0,0" Click="SaveCfKey_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 结果列表 -->
            <ListBox x:Name="HitList" Grid.Row="4" Margin="16,0,16,0"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource HitItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="HitList_MouseDoubleClick"/>

            <!-- 底部 -->
            <Grid Grid.Row="5" Margin="16,8,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="InstallBtn" Style="{StaticResource PrimaryButton}" Content="安装到当前实例"
                                Width="150" Click="Install_Click"/>
                        <TextBlock x:Name="StatusText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="双击结果 = 安装"
                               FontSize="10" Foreground="{DynamicResource TextFaint}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LinkBox" Grid.Column="0" Height="30"
                             ToolTip="粘贴 jar 直链（如 mcmod 过验证码后拿到的下载链接、网盘直链）"/>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="从链接安装" Width="110"
                            Margin="8,0,0,0" Click="InstallFromLink_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
